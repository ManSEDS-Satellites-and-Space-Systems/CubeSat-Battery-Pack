	(text "Two reverse current blocking eFuse for portection.\nDuring discharge, IC1 would be enabled while IC2 is block.\nDuring discharge, vise versa.\nThe eFuse provides OVLO(for charge), UVLO(for discharge), \nOVP(Current limit) and Inrush current protection."
		(exclude_from_sim no)
		(at 155.956 24.638 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "7851cd1a-4f1a-4ad6-8152-91f6d90ae900")
	)
